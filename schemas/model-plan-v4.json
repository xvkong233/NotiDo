{
  "$defs": {
    "ClarifyPlan": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Ambiguities",
          "type": "array"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "intent": {
          "const": "clarify",
          "title": "Intent",
          "type": "string"
        },
        "question_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Question Ref",
          "type": "string"
        },
        "schema_version": {
          "const": 4,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "ambiguities",
        "intent",
        "question_ref",
        "answer"
      ],
      "title": "ClarifyPlan",
      "type": "object"
    },
    "CompletePlan": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Ambiguities",
          "type": "array"
        },
        "intent": {
          "const": "complete",
          "title": "Intent",
          "type": "string"
        },
        "schema_version": {
          "const": 4,
          "title": "Schema Version",
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "schema_version",
        "ambiguities",
        "intent",
        "target"
      ],
      "title": "CompletePlan",
      "type": "object"
    },
    "CreateItem": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "create",
          "title": "Action",
          "type": "string"
        },
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "title": "Ambiguities",
          "type": "array"
        },
        "attachment_asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Attachment Asset Ids",
          "type": "array"
        },
        "date_kind": {
          "enum": [
            "timed",
            "date_only",
            "none",
            "unresolved"
          ],
          "title": "Date Kind",
          "type": "string"
        },
        "date_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Text"
        },
        "obligation": {
          "enum": [
            "required",
            "optional",
            "informational"
          ],
          "title": "Obligation",
          "type": "string"
        },
        "project_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Project Name"
        },
        "relevance": {
          "enum": [
            "applies",
            "not_applies",
            "unknown"
          ],
          "title": "Relevance",
          "type": "string"
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "title": "Requirements",
          "type": "array"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        },
        "time_kind": {
          "enum": [
            "deadline",
            "event",
            "none"
          ],
          "title": "Time Kind",
          "type": "string"
        },
        "time_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Text"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "action",
        "title",
        "relevance",
        "obligation",
        "requirements",
        "project_name",
        "attachment_asset_ids",
        "date_text",
        "time_text",
        "time_kind",
        "date_kind",
        "source_evidence",
        "ambiguities"
      ],
      "title": "CreateItem",
      "type": "object"
    },
    "CreatePlan": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Ambiguities",
          "type": "array"
        },
        "intent": {
          "const": "create",
          "title": "Intent",
          "type": "string"
        },
        "schema_version": {
          "const": 4,
          "title": "Schema Version",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/CreateItem"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "ambiguities",
        "intent",
        "tasks"
      ],
      "title": "CreatePlan",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "quote": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "location",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "NoActionPlan": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Ambiguities",
          "type": "array"
        },
        "intent": {
          "enum": [
            "unsupported",
            "none"
          ],
          "title": "Intent",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "safe_summary": {
          "title": "Safe Summary",
          "type": "string"
        },
        "schema_version": {
          "const": 4,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "ambiguities",
        "intent",
        "reason",
        "safe_summary"
      ],
      "title": "NoActionPlan",
      "type": "object"
    },
    "NoticePlan": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Ambiguities",
          "type": "array"
        },
        "information_only": {
          "items": {
            "type": "string"
          },
          "title": "Information Only",
          "type": "array"
        },
        "intent": {
          "const": "ingest_notice",
          "title": "Intent",
          "type": "string"
        },
        "material_group_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Material Group Id",
          "type": "string"
        },
        "notice_summary": {
          "title": "Notice Summary",
          "type": "string"
        },
        "optional_items": {
          "items": {
            "type": "string"
          },
          "title": "Optional Items",
          "type": "array"
        },
        "schema_version": {
          "const": 4,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Published At"
        },
        "tasks": {
          "items": {
            "discriminator": {
              "mapping": {
                "create": "#/$defs/CreateItem",
                "update": "#/$defs/UpdateItem"
              },
              "propertyName": "action"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CreateItem"
              },
              {
                "$ref": "#/$defs/UpdateItem"
              }
            ]
          },
          "maxItems": 10,
          "title": "Tasks",
          "type": "array"
        },
        "time_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Basis"
        }
      },
      "required": [
        "schema_version",
        "ambiguities",
        "intent",
        "material_group_id",
        "notice_summary",
        "source_published_at",
        "time_basis",
        "tasks",
        "optional_items",
        "information_only"
      ],
      "title": "NoticePlan",
      "type": "object"
    },
    "Patch": {
      "additionalProperties": false,
      "properties": {
        "all_day": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "All Day"
        },
        "date_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Text"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                0,
                1,
                3,
                5
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "reminder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reminder"
        },
        "time_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Text"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "Patch",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "keyword": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyword"
        },
        "project_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Name"
        },
        "scope": {
          "default": "all",
          "enum": [
            "today",
            "week",
            "seven_days",
            "all",
            "overdue",
            "undated"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "title": "Query",
      "type": "object"
    },
    "QueryPlan": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Ambiguities",
          "type": "array"
        },
        "intent": {
          "const": "query",
          "title": "Intent",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/Query"
        },
        "schema_version": {
          "const": 4,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "ambiguities",
        "intent",
        "query"
      ],
      "title": "QueryPlan",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "keyword": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyword"
        },
        "recent_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recent Ref"
        },
        "selection_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Ref"
        }
      },
      "title": "Target",
      "type": "object"
    },
    "UpdateItem": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "update",
          "title": "Action",
          "type": "string"
        },
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "title": "Ambiguities",
          "type": "array"
        },
        "obligation": {
          "enum": [
            "required",
            "optional",
            "informational"
          ],
          "title": "Obligation",
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/Patch"
        },
        "relevance": {
          "enum": [
            "applies",
            "not_applies",
            "unknown"
          ],
          "title": "Relevance",
          "type": "string"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "action",
        "target",
        "patch",
        "relevance",
        "obligation",
        "source_evidence",
        "ambiguities"
      ],
      "title": "UpdateItem",
      "type": "object"
    },
    "UpdatePlan": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Ambiguities",
          "type": "array"
        },
        "intent": {
          "const": "update",
          "title": "Intent",
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/Patch"
        },
        "schema_version": {
          "const": 4,
          "title": "Schema Version",
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "schema_version",
        "ambiguities",
        "intent",
        "target",
        "patch"
      ],
      "title": "UpdatePlan",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "clarify": "#/$defs/ClarifyPlan",
      "complete": "#/$defs/CompletePlan",
      "create": "#/$defs/CreatePlan",
      "ingest_notice": "#/$defs/NoticePlan",
      "none": "#/$defs/NoActionPlan",
      "query": "#/$defs/QueryPlan",
      "unsupported": "#/$defs/NoActionPlan",
      "update": "#/$defs/UpdatePlan"
    },
    "propertyName": "intent"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/NoticePlan"
    },
    {
      "$ref": "#/$defs/CreatePlan"
    },
    {
      "$ref": "#/$defs/QueryPlan"
    },
    {
      "$ref": "#/$defs/UpdatePlan"
    },
    {
      "$ref": "#/$defs/CompletePlan"
    },
    {
      "$ref": "#/$defs/ClarifyPlan"
    },
    {
      "$ref": "#/$defs/NoActionPlan"
    }
  ]
}
