          "type": "integer"
        },
        "summary_days": {
          "default": 90,
          "maximum": 3650,
          "minimum": 1,
          "title": "Summary Days",
          "type": "integer"
        }
      },
      "title": "RetentionBudget",
      "type": "object"
    },
    "TimeBudget": {
      "additionalProperties": false,
      "properties": {
        "group_read_seconds": {
          "default": 180,
          "maximum": 600,
          "minimum": 1,
          "title": "Group Read Seconds",
          "type": "integer"
        },
        "read_seconds": {
          "default": 60,
          "maximum": 180,
          "minimum": 1,
          "title": "Read Seconds",
          "type": "integer"
        }
      },
      "title": "TimeBudget",
      "type": "object"
