        "completed_task_days": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Completed Task Days",
          "type": "integer"
        },
        "dedup_minimum_days": {
          "default": 180,
          "maximum": 3650,
          "minimum": 180,
