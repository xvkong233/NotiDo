  "additionalProperties": false,
  "properties": {
    "account_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Ref"
    },
    "account_region": {
      "const": "cn",
      "default": "cn",
      "title": "Account Region",
      "type": "string"
    },
    "allowed_projects": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Projects",
      "type": "array"
    },
    "authorization_revision": {
      "default": 0,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "credential_generation": {
      "default": 0,
      "title": "Credential Generation",
      "type": "integer"
    },
    "default_project": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Project"
    },
    "materials": {
      "$ref": "#/$defs/MaterialBudget"
    },
    "max_inbox": {
      "default": 1000,
      "maximum": 10000,
      "minimum": 10,
      "title": "Max Inbox",
      "type": "integer"
    },
    "max_jobs": {
      "default": 100,
      "maximum": 1000,
      "minimum": 10,
      "title": "Max Jobs",
      "type": "integer"
    },
    "min_free_bytes": {
      "default": 1073741824,
      "minimum": 0,
      "title": "Min Free Bytes",
      "type": "integer"
    },
    "project_aliases": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Project Aliases",
      "type": "object"
    },
    "retention": {
      "$ref": "#/$defs/RetentionBudget"
    },
    "time_budgets": {
      "$ref": "#/$defs/TimeBudget"
    },
    "timezone": {
      "default": "Asia/Shanghai",
      "title": "Timezone",
      "type": "string"
    }
